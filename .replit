run = "npm start"
entrypoint = "server.js"
modules = ["nodejs-22", "python-base-3.13", "postgresql-16"]

[deployment]
run = ["sh", "-c", "PORT=5000 NODE_ENV=production npm start"]
deploymentTarget = "vm"
build = ["npm", "ci", "--omit=dev"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=5000 npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 23636
externalPort = 3000
